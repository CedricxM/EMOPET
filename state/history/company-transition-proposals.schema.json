{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emopet.invalid/schema/company-transition-proposals.schema.json",
  "title": "EMOPET Company OS Transition Proposal Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_mode",
    "base_ref",
    "candidate_ref",
    "base_state_manifest",
    "candidate_state_manifest",
    "generated_on",
    "proposals"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "authority_mode": {
      "type": "string",
      "const": "DIFF_PROPOSALS_REQUIRE_EXPLICIT_REVIEW"
    },
    "base_ref": {
      "type": "string",
      "pattern": "^(main|head|commit)@[0-9a-f]{40}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^(main|head|commit)@[0-9a-f]{40}$"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "base_state_manifest": {
      "$ref": "#/$defs/stateManifest"
    },
    "candidate_state_manifest": {
      "$ref": "#/$defs/stateManifest"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "path",
            "issue",
            "pr",
            "commit",
            "external"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "review_status",
        "kind",
        "subject_id",
        "field",
        "before_value",
        "after_value",
        "source_path",
        "authority_refs",
        "evidence_refs",
        "decision_refs",
        "append_ready",
        "note"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^EMO-PROPOSAL-[0-9]{8}-[0-9]{4}$"
        },
        "review_status": {
          "type": "string",
          "const": "REVIEW_REQUIRED"
        },
        "kind": {
          "type": "string",
          "enum": [
            "OBJECT_ADDED",
            "OBJECT_REMOVED",
            "STATE_TRANSITION",
            "AUTHORITY_TRANSITION",
            "EVIDENCE_TRANSITION",
            "DECISION_TRANSITION"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "before_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "after_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "authority_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "append_ready": {
          "type": "boolean",
          "const": false
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateManifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob_sha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "enum": [
            "state/company-state.json",
            "state/corporate/corporate-state.json",
            "state/freshness/freshness-state.json",
            "state/milestones/MS-S1-PHYSICS.json",
            "state/experiments/EXP-MAT-INCREMENTAL-001.json",
            "state/experiments/EXP-TAG-PHYSICAL-001.json",
            "state/finance/finance-state.json",
            "state/finance/fundraising/PRESEED-CONDITIONAL-2027.json",
            "state/metrics/metrics.json",
            "state/risks/risk-register.json",
            "state/unknowns/critical-unknowns.json"
          ]
        },
        "git_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "stateManifest": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/stateManifestEntry"
      }
    }
  }
}
