{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMOPET Company OS Metrics Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "authority_mode",
    "principle",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "authority_mode": {
      "type": "string",
      "minLength": 1
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "status",
          "definition",
          "unit",
          "value",
          "target",
          "authority_refs",
          "decision_refs",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^METRIC-[A-Z0-9-]+$"
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "target": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "status"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "authority_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "decision_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "anti_gaming_rule": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "path",
            "issue",
            "pr",
            "commit",
            "external"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
