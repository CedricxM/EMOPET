{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMOPET Company OS Experiment Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "stage",
    "status",
    "authority_mode",
    "owner_role",
    "decision_question",
    "authority_refs",
    "thresholds",
    "allowed_decisions",
    "current_decision",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^EXP-[A-Z0-9-]+$"
    },
    "type": {
      "type": "string",
      "const": "experiment"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "authority_mode": {
      "type": "string",
      "minLength": 1
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "decision_question": {
      "type": "string",
      "minLength": 1
    },
    "authority_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "comparison_arms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "values"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": [
            "object",
            "array",
            "number",
            "string",
            "null"
          ]
        }
      }
    },
    "allowed_decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "current_decision": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "anti_bias_rule": {
      "type": "string",
      "minLength": 1
    },
    "prohibition": {
      "type": "string",
      "minLength": 1
    }
  },
  "anyOf": [
    {
      "required": [
        "required_evidence"
      ]
    },
    {
      "required": [
        "required_domains"
      ]
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "path",
            "issue",
            "pr",
            "commit",
            "external"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
