{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMOPET Company OS Milestone Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "stage",
    "status",
    "authority_mode",
    "updated_at",
    "question",
    "required_gates",
    "exit_rule",
    "unlocks",
    "does_not_unlock"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^MS-[A-Z0-9-]+$"
    },
    "type": {
      "type": "string",
      "const": "milestone"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "authority_mode": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "required",
          "authority_refs",
          "experiment_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[A-Z0-9-]+$"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "authority_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "experiment_ref": {
            "type": "string",
            "pattern": "^EXP-[A-Z0-9-]+$"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      }
    },
    "exit_rule": {
      "type": "string",
      "minLength": 1
    },
    "unlocks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "does_not_unlock": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "path",
            "issue",
            "pr",
            "commit",
            "external"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
