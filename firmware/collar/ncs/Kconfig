mainmenu "EMOPET TAG"

source "Kconfig.zephyr"

menu "EMOPET Device Trust"

config EMOPET_DEVICE_KEY_PROVISIONING
    bool "Enable bounded P-256 identity-key provisioning primitive"
    default n
    depends on PSA_CRYPTO
    depends on SECURE_STORAGE
    depends on HW_UNIQUE_KEY
    depends on SECURE_STORAGE_ITS_TRANSFORM_AEAD_KEY_PROVIDER_HUK_LIBRARY
    help
      Enables the source primitive that creates one persistent P-256 identity
      key under an explicit PSA key id and exports the public key only.

      This option is deliberately OFF by default. It must not be enabled for
      EMOPET production until #657 records NSIB/HUK provisioning, Secure Storage
      protection, partition/layout evidence, APPROTECT policy and representative
      MS88SF3 reboot/sign/verify evidence.

endmenu
