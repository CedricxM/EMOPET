{
  "name": "@emopet/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch api/index.ts",
    "build": "tsc",
    "start": "node dist/api/index.js",
    "test": "node --test test/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "auth-email:dispatch": "node dist/api/workers/auth-email-verification-delivery.js",
    "auth-email:legacy-audit": "node dist/api/workers/auth-email-legacy-rollout-audit.js"
  },
  "dependencies": {
    "@emopet/eli-engine": "workspace:*",
    "@emopet/privileged-auth": "workspace:*",
    "@emopet/shared": "workspace:*",
    "@heroiclabs/nakama-js": "2.8.0",
    "@hono/node-server": "^1.19.13",
    "@hono/zod-validator": "^0.8.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "jose": "^6.0.0",
    "nanoid": "^5.1.16",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
