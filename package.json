{
  "name": "emopet",
  "version": "1.0.0",
  "private": true,
  "description": "EMOPET — Deeptech canine wellness monitoring platform",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "backend:dev": "pnpm --filter @emopet/api dev",
    "mobile:dev": "pnpm --filter @emopet/mobile start",
    "mobile:ios": "pnpm --filter @emopet/mobile ios",
    "mobile:android": "pnpm --filter @emopet/mobile android",
    "web:dev": "pnpm --filter @emopet/web dev",
    "web:build": "pnpm --filter @emopet/web build",
    "web:start": "pnpm --filter @emopet/web start",
    "legacy-freemium:audit": "node scripts/content/legacy-freemium-authority-audit.mjs",
    "science:rr-audit": "node scripts/science/rr-variability-window-audit.mjs",
    "science:rr-audit:test": "node --test scripts/science/rr-variability-window-audit.test.mjs",
    "control:ip-provenance-audit": "node scripts/control/ip-provenance-register-audit.mjs",
    "control:ip-provenance-audit:test": "node --test scripts/control/ip-provenance-register-audit.test.mjs",
    "hardware:tag-source-coherence": "node scripts/hardware/tag-source-coherence.mjs",
    "hardware:tag-source-coherence:test": "node --test scripts/hardware/tag-source-coherence.test.mjs"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
