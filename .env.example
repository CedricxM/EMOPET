# Database
# Runtime application role: DML only, no SUPERUSER/CREATEDB/CREATEROLE/REPLICATION/BYPASSRLS/schema CREATE.
DATABASE_URL="postgres://APP_USER:APP_PASSWORD@HOST:5432/DB_NAME"
# Migration/DDL authority: use only in migration jobs, not in the long-lived API runtime.
MIGRATION_DATABASE_URL="postgres://MIGRATION_USER:MIGRATION_PASSWORD@HOST:5432/DB_NAME"
REDIS_URL="redis://HOST:6379"

# Auth / sessions
AUTH_SECRET="replace-with-random-secret"
JWT_SECRET="replace-with-random-secret"
AUTH_RATE_LIMIT_HMAC_SECRET="replace-with-random-secret-distinct-from-jwt-secret"
REPORT_SHARE_SECRET="replace-with-random-secret"
PRIVILEGED_JWT_SECRET="replace-with-random-secret-distinct-from-jwt-secret"
ADMIN_SEED_TOKEN="replace-with-admin-seed-token"

# OAuth
APPLE_CLIENT_ID="com.example.emopet"
GOOGLE_CLIENT_ID="replace-with-google-client-id"

# Payments (future)
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"
ALMA_API_KEY="alma_placeholder"

# AI
ANTHROPIC_API_KEY="anthropic_placeholder"
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
EMOPET_ANTHROPIC_EGRESS_GATE="HOLD"
AI_MODEL="claude-3-5-haiku-latest"

# Map / analytics
NEXT_PUBLIC_MAPBOX_TOKEN="pk.placeholder"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="example.com"

# Notifications
RESEND_API_KEY="re_placeholder"
RESEND_FROM="emopet <onboarding@example.com>"
AUTH_EMAIL_VERIFICATION_URL="http://localhost:3100/verify-email"
TEAM_EMAIL="security@example.com"
EXPO_ACCESS_TOKEN="expo_placeholder"

# Weather / local services
OPENWEATHERMAP_API_KEY="owm_placeholder"

# Breiz / territorial data (credentials only; sources remain fail-closed until explicitly enabled)
INSEE_API_KEY=
DATATOURISME_API_KEY=

# Storage
S3_ENDPOINT="https://s3.example.com"
S3_BUCKET="emopet-placeholder"
S3_ACCESS_KEY="s3_access_placeholder"
S3_SECRET_KEY="s3_secret_placeholder"

# Monitoring
SENTRY_DSN="https://public@example.invalid/1"
POSTHOG_API_KEY="phc_placeholder"

# Backend
PORT="3000"
CORS_ORIGIN="http://localhost:3100"

# Feature flags
FEATURE_COPRESENCE="false"
FEATURE_MARKETPLACE="false"
FEATURE_PREDICTIVE_AI="false"

# Internal privileged-audit emission (server-to-server only)
# Keep this secret distinct from JWT_SECRET and PRIVILEGED_JWT_SECRET.
EMOPET_INTERNAL_BACKEND_URL="http://127.0.0.1:3000"
EMOPET_INTERNAL_AUDIT_SERVICE_SECRET=
# Dedicated body-bound security-alert acknowledgement service key.
# Must differ from JWT_SECRET, PRIVILEGED_JWT_SECRET and the audit service secret.
EMOPET_INTERNAL_ALERT_ACK_SERVICE_SECRET=
# Dedicated body-bound Owner-session refresh service key.
# Must differ from JWT_SECRET, PRIVILEGED_JWT_SECRET, the audit key and the alert-ack key.
EMOPET_INTERNAL_OWNER_SESSION_SERVICE_SECRET=
