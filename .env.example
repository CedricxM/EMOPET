# Exemple de variables d'environnement pour EMOPET

# URL publique de l'API EMOPET (remplacez par votre URL)
EMOPET_URL=https://api.emopet.example.com

# Credentials OAuth (remplir via GitHub Secrets ou votre environnement de déploiement)
EMOPET_CLIENT_ID=your_client_id_here
# EMOPET_CLIENT_SECRET est optionnel si vous utilisez PKCE
EMOPET_CLIENT_SECRET=your_client_secret_here
