# Database
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB_NAME"
REDIS_URL="redis://HOST:6379"

# Auth / sessions
AUTH_SECRET="replace-with-random-secret"
JWT_SECRET="replace-with-random-secret"
REPORT_SHARE_SECRET="replace-with-random-secret"
ADMIN_TOKEN="replace-with-admin-token"
ADMIN_SEED_TOKEN="replace-with-admin-seed-token"

# OAuth
APPLE_CLIENT_ID="com.example.emopet"
GOOGLE_CLIENT_ID="replace-with-google-client-id"

# Payments (future)
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"
ALMA_API_KEY="alma_placeholder"

# AI
ANTHROPIC_API_KEY="anthropic_placeholder"
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
AI_MODEL="claude-3-5-haiku-latest"

# Map / analytics
NEXT_PUBLIC_MAPBOX_TOKEN="pk.placeholder"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="example.com"

# Notifications
RESEND_API_KEY="re_placeholder"
RESEND_FROM="emopet <onboarding@example.com>"
TEAM_EMAIL="security@example.com"
EXPO_ACCESS_TOKEN="expo_placeholder"

# Weather / local services
OPENWEATHERMAP_API_KEY="owm_placeholder"

# Storage
S3_ENDPOINT="https://s3.example.com"
S3_BUCKET="emopet-placeholder"
S3_ACCESS_KEY="s3_access_placeholder"
S3_SECRET_KEY="s3_secret_placeholder"

# Monitoring
SENTRY_DSN="https://public@example.invalid/1"
POSTHOG_API_KEY="phc_placeholder"

# Backend
PORT="3000"
CORS_ORIGIN="http://localhost:3100"

# Feature flags
FEATURE_COPRESENCE="false"
FEATURE_MARKETPLACE="false"
FEATURE_PREDICTIVE_AI="false"
